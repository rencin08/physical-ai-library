# Public browser credentials from Supabase Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this value in client components.
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/ingest. Generate a long random value for production.
CRON_SECRET=

# Optional enrichments
GITHUB_TOKEN=
SEMANTIC_SCHOLAR_API_KEY=

# Comma-separated RSS/Atom feeds. Add lab, news, and VC feeds here.
CONTENT_FEED_URLS=

# Optional: absolute local folder path for automatic journal backups.
# Only enabled on localhost. Leave blank on a public deployment.
LIBRARY_BACKUP_DIRECTORY=

# Optional, server-only: on-demand paper-guide drafts.
OPENAI_API_KEY=
# Model must support image inputs, structured output, and medium reasoning.
OPENAI_GUIDE_MODEL=

# Optional: preferred local library origin; discovery also detects ports 3001/3000.
LIBRARY_BASE_URL=
# Optional: location for personal imported papers and discovery preferences.
LIBRARY_PERSONAL_DIRECTORY=
